'use strict'

//Import required MODEL SCHEMAS from models MODULE...
var clientModelItem = require('../MODELS/client.js')

// Import auxiliary functions MODULE...
let auxFuncModule = require('../CONTROLLERS/auxiliary_functions.js')

// All controllers logic definition and implementation... 
var controller = {

//#region [ v1.2 CONTROLLER ]

    //[?][ CREATE NEW CLIENT ]
    create_client: async function(req,res)
    {
        let function_name = "create_client"
        auxFuncModule.logger(function_name, 18,0)

        /* - Step [1]
        *  - Receive values from CLIENT...
        *  - via POST -> BODY
        */
        let newClientObject = new clientModelItem()
        let bodyValues      = req.body  

        newClientObject.client_id           = auxFuncModule.isValidValue(bodyValues.client_id)         ? bodyValues.client_id.toUpperCase()       : 'DATO NO ASIGNADO' ,
        newClientObject.client_name         = auxFuncModule.isValidValue(bodyValues.client_name)       ? bodyValues.client_name.toUpperCase()     : 'DATO NO ASIGNADO' ,
        newClientObject.client_priority     = auxFuncModule.isValidValue(bodyValues.client_priority)   ? bodyValues.client_priority.toUpperCase() : 'DATO NO ASIGNADO' , 
        newClientObject.client_status       = auxFuncModule.isValidValue(bodyValues.client_status  )   ? bodyValues.client_status  .toUpperCase() : 'DATO NO ASIGNADO' ,
        newClientObject.client_registration = auxFuncModule.timeSnapshot()
        
        auxFuncModule.logger(function_name,33,1,1,"[i] Values have been received...")

        /* - Step [2]
        *  - Validate if client is already created, if not then create it... BE SURE TO CHANGE IT TO AN ID...!
        */ 
        await clientModelItem.find({client_name:newClientObject.client_name}).then((clientObjectFound)=>
        {
            //Not found, then save new...
            if(clientObjectFound.length == 0)
            {
                newClientObject.save()
                auxFuncModule.logger(function_name,44,2,1,"[i] Client has been created...")
                return res.status(200).send({message:'1'})
            }else
            {
                auxFuncModule.logger(function_name,48,2,2,"[i] Client already exists, not storing...")
                return res.status(200).send({message:'0'})
            } 
        }).catch((err)=>
        {
            auxFuncModule.logger(function_name,53,2,3,"[e] "+err)
            return res.status(200).send({message:'0'})  
        }) 
    },





    // [ READ CLIENTS ] 
    read_clients: async function(req,res)
    {
        let function_name = "read_clients"
        auxFuncModule.logger(function_name, 75,0)

        /* - Step [1]
        *  - Search for stored clients in DB...
        */
        await clientModelItem.find({}).then((clientsFound)=>
        {
            let client_names = []

            // No clients stored...
            if(clientsFound.length === 0)
            {
                auxFuncModule.logger(function_name, 87,1,1,"[i] No clients stored in DB...")  
                return res.status(200).send({message:'0'})
            }else
            {
                // Return only names...
                for (let index = 0; index < clientsFound.length; index++) 
                {
                    client_names.push(clientsFound[index].client_name)
                }

                auxFuncModule.logger(function_name, 97,1,1,"[i] Sending all CLIENTS names...")  
                return res.status(200).send({client_names})
            }

        }).catch((err)=>
        {
            auxFuncModule.logger(function_name, 103,1,3,"[e] "+err)
            return res.status(200).send({message:'0'})  
        })
    },





    // [ UPDATE CLIENT ] 
    update_client: async function(req,res)
    {
        let function_name = "update_client"
        auxFuncModule.logger(function_name, 107,0)

        /* - Step [1]
        *  - Receive values from CLIENT...
        *  - via POST -> BODY
        */
        let newClientObject = new clientModelItem()
        let bodyValues      = req.body  

        newClientObject.client_name = auxFuncModule.isValidValue(bodyValues.new_client_name) ? bodyValues.new_client_name.toUpperCase() : 'DATO NO ASIGNADO' ,
        
        auxFuncModule.logger(function_name,118,1,1,"[i] Values have been received...")

        /* - Step [2]
        *  - Search for stored clients in DB...
        */
        await clientModelItem.findOneAndUpdate({client_name:bodyValues.client_name_to_update},{client_name:newClientObject.client_name},{new:true}).then((updatedClient)=>
        {
            if(!updatedClient)
            {
                auxFuncModule.logger(function_name, 127,2,2,"[e] Client was not found, hence, not updated...")  
                return res.status(200).send({message:'0'})       
            }else
            {
                auxFuncModule.logger(function_name, 131,2,2,"[e] Client update complete...")  
                return res.status(200).send({message:'1'})
            }                   
        }).catch((err)=>
        {
            auxFuncModule.logger(function_name, 136,2,3,"[e] "+err)
            return res.status(200).send({message:'0'})  
        })  
    },





    // [ DELETE CLIENT ] 
    delete_client: async function(req,res)
    {
        let function_name = "delete_client"
        auxFuncModule.logger(function_name, 148,0)

        /* - Step [1]
        *  - Receive values from CLIENT...
        *  - via POST -> BODY
        */
        let bodyValues = req.body  

        auxFuncModule.logger(function_name,158,1,1,"[i] Values have been received...")

        /* - Step [2]
        *  - Search for stored clients in DB...
        */
        await clientModelItem.findOneAndDelete({client_name:bodyValues.client_name}).then((deletedClient)=>
        {
            if(!deletedClient)
            {
                auxFuncModule.logger(function_name, 167,2,2,"[e] Client was not found, hence, not deleted...")  
                return res.status(200).send({message:'0'})       
            }else
            {
                auxFuncModule.logger(function_name, 171,2,1,"[i] Client delete complete...")  
                return res.status(200).send({message:'1'})
            }                   
        }).catch((err)=>
        {
            auxFuncModule.logger(function_name, 176,2,3,"[e] "+err)
            return res.status(200).send({message:'0'})  
        })  
    },


//#endregion [ v1.1 CONTROLLER ]

}

module.exports = controller

//#region [?] [ LOCAL COMMON AUX FUNCTIONS ]


/** [? V1.2][ TIME FORMAT ]
 *  @returns String date-time value dd-month-year  hh:mm:ss
 *  @note es-mx language used as default 
 */
function formatTime(time2format)
{
    if (time2format != 'PENDIENTE') 
    {
        const dateTime = new Date(time2format)

        const day     = dateTime.getDate() < 10 ? '0' + dateTime.getDate() : dateTime.getDate() 
        const month   = dateTime.toLocaleString('es-mx',{month:'long'}).toUpperCase()
        const year    = dateTime.getFullYear()
        const hours   = dateTime.getHours()   < 10 ? "0" + dateTime.getHours()   : dateTime.getHours()
        const minutes = dateTime.getMinutes() < 10 ? "0" + dateTime.getMinutes() : dateTime.getMinutes()
        const seconds = dateTime.getSeconds() < 10 ? "0" + dateTime.getSeconds() : dateTime.getSeconds()

        const timeSnapshot = day +"-"+month+"-"+year+"  "+hours+":"+minutes+":"+seconds

        return timeSnapshot
   
    }else
    {
        return 'PENDIENTE'
    }
}


//#endregion [ [?] LOCAL AUX FUNCTIONS ]