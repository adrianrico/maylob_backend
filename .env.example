# ── Entorno: "local" o "production" ───────────────────────────────────────────
APP_ENV=local

PORT_LOCAL=8080
PORT_PRODUCTION=8080

# ── Base de datos ────────────────────────────────────────────────────────────
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/maylobdb
MONGO_URI_PRODUCTION=<tu-uri-de-mongodb-atlas-aqui>

# ── SEGURIDAD ────────────────────────────────────────────────────────────────
# OBLIGATORIAS en production (el servidor no arranca sin ellas). Opcionales en local.
#
# Llave del administrador (portal admin / til_forwarder), enviada en el header X-API-Key.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Secreto para firmar los JWT de operadores (mínimo 32 caracteres). Genera uno igual que arriba.
JWT_SECRET=

# Duración de la sesión del operador (ej. 8h, 30m).
JWT_EXPIRES_IN=8h

# Orígenes web permitidos por CORS, separados por coma. Ej: https://admin.midominio.com,https://operador.midominio.com
CORS_ORIGINS=

# Nº de proxies de confianza delante de la app (Render = 1).
TRUST_PROXY=1

# Máximo de peticiones por IP cada 15 min (límite global).
RATE_LIMIT_MAX=600

# SOLO MIGRACIÓN: acepta el header inseguro X-Operator-Curp como credencial. Dejar en false.
ALLOW_LEGACY_OPERATOR_HEADER=false
